{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sysu-rnaseq-agent/benchmark-case.schema.json",
  "title": "RNA-seq Agent reproducibility benchmark case",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "expected_mode", "runs"],
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "expected_mode": {"enum": ["free", "skill", "contract"]},
          "description": {"type": "string"},
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "run_label": {"type": "string"},
                "run_id": {"type": "string"},
                "manifest": {"type": ["string", "null"]},
                "result_manifest": {"type": ["string", "null"]},
                "success": {"type": ["boolean", "null"]},
                "outcome": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
